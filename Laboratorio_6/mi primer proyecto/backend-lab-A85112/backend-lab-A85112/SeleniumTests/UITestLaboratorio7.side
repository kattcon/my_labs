    }, {
      "id": "a8ba3cd6-96ed-4b80-af8b-f379e7c675ba",
      "comment": "",
      "command": "assertText",
      "target": "css=th:nth-child(1)",
      "targets": [
        ["css=th:nth-child(1)", "css:finder"],
        ["xpath=//div[@id='app']/div/table/thead/tr/th", "xpath:idRelative"],
        ["xpath=//th", "xpath:position"],
        ["xpath=//th[contains(.,'Nombre')]", "xpath:innerText"]
      ],
      "value": "Nombre"
    }, {
      "id": "53cab7b5-b052-438a-9d06-f9f8226a2b62",
      "comment": "",
      "command": "assertText",
      "target": "css=tr:nth-child(3) > td:nth-child(3)",
      "targets": [
        ["css=tr:nth-child(3) > td:nth-child(3)", "css:finder"],
        ["xpath=//div[@id='app']/div/table/tbody/tr[3]/td[3]", "xpath:idRelative"],
        ["xpath=//tr[3]/td[3]", "xpath:position"],
        ["xpath=//td[contains(.,'Inglés/Frances')]", "xpath:innerText"]
      ],
      "value": "Inglés/Frances"
    }, {
      "id": "c1d2e3f4-a5b6-47c8-d9e0-f1a2b3c4d5e6",
