        ["xpath=//th[contains(.,'Idioma')]", "xpath:innerText"]
      ],
      "value": "Idioma"
    }, {
      "id": "f4a5b6c7-d8e9-40f1-a2b3-c4d5e6f7a8b9",
      "comment": "Verificar columna Acciones",
