      "comment": "Verificar columna Continente",
      "command": "assertText",
      "target": "css=th:nth-child(2)",
      "targets": [
        ["css=th:nth-child(2)", "css:finder"],
        ["xpath=//th[contains(.,'Continente')]", "xpath:innerText"]
      ],
      "value": "Continente"
    }, {
      "id": "e3f4a5b6-c7d8-49e0-f1a2-b3c4d5e6f7a8",
      "comment": "Verificar columna Idioma",
      "command": "assertText",
